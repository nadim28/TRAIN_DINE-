<!-- res/layout/activity_train_info.xml -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:background="#70AC57"
    android:padding="16dp">

    <TextView
        android:id="@+id/textViewTrainName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Train Name:"
        android:textSize="18sp"/>

    <EditText
        android:id="@+id/editTextTrainName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/textViewTrainName"
        android:layout_marginTop="8dp"
        android:hint="Enter Train Name"/>

    <TextView
        android:id="@+id/textViewDepartureTime"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/editTextTrainName"
        android:layout_marginTop="16dp"
        android:text="Enter Train Coach:"
        android:textSize="18sp"/>

    <EditText
        android:id="@+id/editTextDepartureTime"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/textViewDepartureTime"
        android:layout_marginTop="8dp"
        android:hint="Ex- KA"/>

    <TextView
        android:id="@+id/textViewArrivalTime"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/editTextDepartureTime"
        android:layout_marginTop="16dp"
        android:text="Enter Seat no: "
        android:textSize="18sp"/>

    <EditText
        android:id="@+id/editTextArrivalTime"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/textViewArrivalTime"
        android:layout_marginTop="8dp"
        android:hint="Ex-12"/>

    <TextView
        android:id="@+id/textViewTrainNumber"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/editTextArrivalTime"
        android:layout_marginTop="16dp"
        android:text="Train Number:"
        android:textSize="18sp"/>

    <EditText
        android:id="@+id/editTextTrainNumber"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/textViewTrainNumber"
        android:layout_marginTop="8dp"
        android:hint="Enter Train Number"/>


    <Button
        android:id="@+id/buttonSubmit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/editTextTrainNumber"
        android:layout_marginTop="24dp"
        android:text="Submit"/>

</RelativeLayout>
